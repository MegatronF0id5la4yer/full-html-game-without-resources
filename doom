  // Carton rojo carmesi (#9e1f18)
  ctx.fillStyle = '#9e1f18';
  ctx.fillRect(x - w / 2, y + h * 0.18, w, h * 0.28);
  // Culotes de laton dorado (#d4ad37)
  ctx.fillStyle = '#d4ad37';
  ctx.fillRect(x - w * 0.38, y + h * 0.21, w * 0.76, h * 0.08);
}

// FIREBALL: Bola de plasma y fuego lanzada por el Imp
function drawFireball(x, y, h) {
  let r = h * 0.22;
  let grad = ctx.createRadialGradient(x, y, 1, x, y, r);
  grad.addColorStop(0, '#ffffff');
  grad.addColorStop(0.3, '#ffcc00');
  grad.addColorStop(0.7, '#e63300');
  grad.addColorStop(1, 'rgba(100, 10, 0, 0)');
  ctx.fillStyle = grad;
  ctx.beginPath();
  ctx.arc(x, y, r, 0, Math.PI * 2);
  ctx.fill();
}

// ==========================================
// ARMAS EN PRIMERA PERSONA CON PALETA ORIGINAL
// ==========================================
function renderWeapon() {
  let cx = SCREEN_W / 2;
  let cy = VIEW_H;
  let bob = Math.sin(performance.now() * 0.008) * 8;

  if (player.currentWeapon === 1) { // PISTOLA ESTANDAR UAC 9MM
    let f = player.shootAnim;
    let kick = (f > 8) ? (f - 8) * 9 : 0;

    // Mano enguantada / piel Doom Marine (#cfa27c)
    ctx.fillStyle = '#cfa27c';
    ctx.fillRect(cx - 30, cy - 130 + bob + kick, 60, 140);
    // Corredera y cañon de acero pavonado (#33353b)
    ctx.fillStyle = '#33353b';
    ctx.fillRect(cx - 18, cy - 240 + bob + kick, 36, 120);
    ctx.fillStyle = '#585b63';
    ctx.fillRect(cx - 10, cy - 250 + bob + kick, 20, 20);

    // Fogonazo de boca de cañon
    if (f > 8) {
      ctx.fillStyle = '#ffe852';
      ctx.beginPath();
      ctx.arc(cx, cy - 265 + kick, 45, 0, Math.PI * 2);
      ctx.fill();
    }
  } else if (player.currentWeapon === 2) { // ESCOPETA CLASICA CORREDERA
    let f = player.shootAnim;
    let kick = (f > 22) ? (f - 22) * 12 : 0;
    let pump = (f > 8 && f <= 18) ? Math.sin((f - 8) * 0.31) * 35 : 0;

    // Manos del Doom Slayer en el guardamanos y culata (#cfa27c)
    ctx.fillStyle = '#cfa27c';
    ctx.fillRect(cx - 140, cy - 120 + bob, 80, 130);
    ctx.fillRect(cx + 80, cy - 140 + bob + kick, 90, 140);

    // Cañon doble de acero gris plomo (#2b2d33)
    ctx.fillStyle = '#2b2d33';
    ctx.fillRect(cx - 45, cy - 310 + bob + kick, 90, 260);
    ctx.fillStyle = '#4c5059';
    ctx.fillRect(cx - 38, cy - 325 + bob + kick, 34, 30);
    ctx.fillRect(cx + 4, cy - 325 + bob + kick, 34, 30);

    // Guardamanos de madera de nogal (#6b3c1b)
    ctx.fillStyle = '#6b3c1b';
    ctx.fillRect(cx - 48, cy - 180 + bob + kick + pump, 96, 65);
    ctx.fillStyle = '#9e5927';
    ctx.fillRect(cx - 42, cy - 176 + bob + kick + pump, 84, 8);

    // Fogonazo iconico
    if (f > 22) {
      let fGrad = ctx.createRadialGradient(cx, cy - 340 + kick, 10, cx, cy - 340 + kick, 120);
      fGrad.addColorStop(0, '#ffffff');
      fGrad.addColorStop(0.4, '#ffd52b');
      fGrad.addColorStop(1, 'rgba(215, 35, 10, 0)');
      ctx.fillStyle = fGrad;
      ctx.beginPath();
      ctx.arc(cx, cy - 340 + kick, 130, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  // Punto de mira clasico sutil
  ctx.strokeStyle = 'rgba(255, 255, 255, 0.5)';
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(cx - 8, VIEW_H / 2); ctx.lineTo(cx + 8, VIEW_H / 2);
  ctx.moveTo(cx, VIEW_H / 2 - 8); ctx.lineTo(cx, VIEW_H / 2 + 8);
  ctx.stroke();
}

// ==========================================
// STATUS BAR OFICIAL DE DOOM (STBAR)
// ==========================================
function renderDoomHUD() {
  let hy = VIEW_H;

  // Fondo de roca / piedra gris original (STBAR texture)
  ctx.fillStyle = '#383838';
  ctx.fillRect(0, hy, SCREEN_W, HUD_H);
  ctx.fillStyle = '#1c1c1c';
  ctx.fillRect(0, hy, SCREEN_W, 6);

  ctx.font = 'bold 36px monospace';
  ctx.textBaseline = 'middle';

  // PANEL AMMO
  ctx.fillStyle = '#1c1c1c';
  ctx.fillRect(58, hy + 23, 264, 124);
  ctx.fillStyle = '#6e150a'; // Fondo rojo oscuro de los marcadores id
  ctx.fillRect(60, hy + 25, 260, 120);
  ctx.fillStyle = '#bf1e15';
  ctx.fillText('AMMO', 80, hy + 55);
  ctx.fillStyle = '#d49b28'; // Digitos LED dorados de Doom
  let curAmmo = (player.currentWeapon === 2) ? player.ammoShells : player.ammoBullets;
  ctx.fillText(curAmmo.toString().padStart(3, ' '), 180, hy + 98);

  // PANEL HEALTH
  ctx.fillStyle = '#1c1c1c';
  ctx.fillRect(358, hy + 23, 304, 124);
  ctx.fillStyle = '#1a291a';
  ctx.fillRect(360, hy + 25, 300, 120);
  ctx.fillStyle = '#bf1e15';
  ctx.fillText('HEALTH', 380, hy + 55);
  ctx.fillStyle = '#d49b28';
  ctx.fillText(`${Math.max(0, player.hp)}%`, 500, hy + 98);

  // DOOMGUY FACE (Retrato animado en el centro del HUD)
  let faceX = SCREEN_W / 2;
  let faceY = hy + HUD_H / 2;
  ctx.fillStyle = '#1c1c1c';
  ctx.fillRect(faceX - 72, hy + 18, 144, 134);
  ctx.fillStyle = '#262626';
  ctx.fillRect(faceX - 70, hy + 20, 140, 130);
  drawDoomGuyFace(faceX, faceY);

  // PANEL ARMOR
  ctx.fillStyle = '#1c1c1c';
  ctx.fillRect(SCREEN_W - 662, hy + 23, 304, 124);
  ctx.fillStyle = '#141d2e';
  ctx.fillRect(SCREEN_W - 660, hy + 25, 300, 120);
  ctx.fillStyle = '#bf1e15';
  ctx.fillText('ARMOR', SCREEN_W - 640, hy + 55);
  ctx.fillStyle = '#d49b28';
  ctx.fillText(`${player.armor}%`, SCREEN_W - 520, hy + 98);

  // PANEL STATS / LEVEL
  ctx.fillStyle = '#1c1c1c';
  ctx.fillRect(SCREEN_W - 322, hy + 23, 264, 124);
  ctx.fillStyle = '#222';
  ctx.fillRect(SCREEN_W - 320, hy + 25, 260, 120);
  ctx.font = 'bold 22px monospace';
  ctx.fillStyle = '#aaa';
  ctx.fillText(`FRAGS: ${player.kills}`, SCREEN_W - 300, hy + 65);
  ctx.fillStyle = '#bf1e15';
  ctx.fillText(`LEVEL: E1M1`, SCREEN_W - 300, hy + 105);
}

// Expresion facial del marine segun salud y disparos (STFST00 / STFST01)
function drawDoomGuyFace(x, y) {
  let hp = player.hp;
  // Tono de piel autentico del Doomguy (#d99f77)
  ctx.fillStyle = (hp > 0) ? '#d99f77' : '#731a1a';
  ctx.fillRect(x - 45, y - 48, 90, 96);
  // Cabello castaño militar (#4a2d18)
  ctx.fillStyle = '#4a2d18';
  ctx.fillRect(x - 45, y - 48, 90, 24);

  if (hp > 0) {
    let look = Math.sin(performance.now() * 0.003) * 6;
    ctx.fillStyle = '#fff';
    ctx.fillRect(x - 28, y - 16, 18, 12);
    ctx.fillRect(x + 10, y - 16, 18, 12);
    ctx.fillStyle = '#2244aa';
    ctx.fillRect(x - 24 + look, y - 14, 10, 8);
    ctx.fillRect(x + 14 + look, y - 14, 10, 8);

    if (player.shootAnim > 18) {
      // Mueca malevola al disparar la escopeta
      ctx.fillStyle = '#551111';
      ctx.fillRect(x - 22, y + 16, 44, 14);
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(x - 18, y + 18, 36, 4);
    } else if (hp < 30) {
      // Rostro ensangrentado
      ctx.fillStyle = '#990000';
      ctx.fillRect(x - 25, y - 5, 12, 28);
      ctx.fillRect(x + 8, y + 10, 8, 20);
      ctx.fillStyle = '#400';
      ctx.fillRect(x - 18, y + 20, 36, 12);
    } else {
      ctx.fillStyle = '#6e3820';
      ctx.fillRect(x - 18, y + 20, 36, 6);
    }
  } else {
    // Ojos cruzados de muerte
    ctx.strokeStyle = '#fff'; ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(x - 25, y - 15); ctx.lineTo(x - 10, y - 5);
    ctx.moveTo(x - 10, y - 15); ctx.lineTo(x - 25, y - 5);
    ctx.moveTo(x + 10, y - 15); ctx.lineTo(x + 25, y - 5);
    ctx.moveTo(x + 25, y - 15); ctx.lineTo(x + 10, y - 5);
    ctx.stroke();
  }
}

// Bucle de ejecucion principal
function loop() {
  update();
  render();
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
</script>
