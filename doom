const E1M1_NOTES = [82.4, 82.4, 164.8, 82.4, 82.4, 146.8, 82.4, 82.4, 130.8, 82.4, 82.4, 116.5, 82.4, 82.4, 123.5, 130.8, 82.4, 82.4, 164.8, 82.4, 82.4, 146.8, 82.4, 82.4, 130.8, 82.4, 82.4, 155.6, 146.8, 130.8, 116.5, 98.0];
function updateMusic() {
  if (!audioCtx) return;
  let tempo = 0.115;
  while (nextNoteTime < audioCtx.currentTime + 0.2) {
    let note = E1M1_NOTES[noteIndex % E1M1_NOTES.length];
    playTone(note, tempo * 0.85, 'sawtooth', 0.045);
    playTone(note * 0.5, tempo * 0.85, 'triangle', 0.055);
    if (noteIndex % 4 === 0) playTone(55, 0.06, 'sine', 0.1, -25);
    if (noteIndex % 8 === 4) playNoise(0.04, 0.045);
    nextNoteTime += tempo; noteIndex++;
  }
}

