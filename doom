// IMP: Cuero marron café, espinas grises/hueso, ojos rojos demoniacos
function drawImp(x, y, h, dead) {
  let w = h * 0.72;
  let topY = y - (dead ? 0 : h / 2.5);
  let totalH = dead ? h / 5 : h / 1.3;

  if (dead) {
    // Charco de sangre demoniaca
    ctx.fillStyle = '#6e1108';
    ctx.fillRect(x - w / 2, topY, w, totalH);
    ctx.fillStyle = '#420804';
    ctx.fillRect(x - w * 0.35, topY + totalH * 0.2, w * 0.7, totalH * 0.5);
    return;
  }

  // Silueta leathern marrón (#7a4e33 original)
  ctx.fillStyle = '#7a4e33';
  ctx.fillRect(x - w * 0.35, topY + totalH * 0.22, w * 0.7, totalH * 0.78);
  // Cabeza y mandibula
  ctx.fillStyle = '#8f5c3d';
  ctx.fillRect(x - w * 0.3, topY, w * 0.6, totalH * 0.3);

  // Espinas/Huesos gris hueso caracteristicas en hombros y cabeza
  ctx.fillStyle = '#c7bca7';
  ctx.fillRect(x - w * 0.44, topY + totalH * 0.18, w * 0.14, totalH * 0.12);
  ctx.fillRect(x + w * 0.3, topY + totalH * 0.18, w * 0.14, totalH * 0.12);
  ctx.fillRect(x - w * 0.22, topY - totalH * 0.06, w * 0.1, totalH * 0.1);
  ctx.fillRect(x + w * 0.12, topY - totalH * 0.06, w * 0.1, totalH * 0.1);

  // Ojos rojos DOOM
  ctx.fillStyle = '#e61d15';
  ctx.fillRect(x - w * 0.22, topY + totalH * 0.08, w * 0.12, totalH * 0.08);
  ctx.fillRect(x + w * 0.1, topY + totalH * 0.08, w * 0.12, totalH * 0.08);

  // Mandibula y boca abierta
  ctx.fillStyle = '#260c07';
  ctx.fillRect(x - w * 0.16, topY + totalH * 0.2, w * 0.32, totalH * 0.07);
}

// SHOTGUN GUY: Uniforme verde oliva militar, pantalones caqui, casco, escopeta en ristre
