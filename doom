];

function isSlimeFloor(x, y) {
  let mx = Math.floor(x), my = Math.floor(y);
  return (mx >= 20 && mx <= 22 && my >= 18 && my <= 20);
}

const doors = [
  { x: 4, y: 4, open: 0, maxOpen: 1, timer: 0, state: 'closed' },
  { x: 3, y: 7, open: 0, maxOpen: 1, timer: 0, state: 'closed' },
  { x: 8, y: 10, open: 0, maxOpen: 1, timer: 0, state: 'closed' },
  { x: 15, y: 12, open: 0, maxOpen: 1, timer: 0, state: 'closed' },
  { x: 5, y: 15, open: 0, maxOpen: 1, timer: 0, state: 'closed' },
  { x: 13, y: 19, open: 0, maxOpen: 1, timer: 0, state: 'closed' },
  { x: 24, y: 19, open: 0, maxOpen: 1, timer: 0, state: 'closed' }
];

function getDoor(x, y) {
  for (let d of doors) if (d.x === x && d.y === y) return d;
  return null;
}

// ==========================================
// ESTADO DEL JUGADOR Y ENTIDADES
// ==========================================
let player = {
  x: 2.5, y: 2.5,
  dirX: 0.0, dirY: 1.0,
  planeX: -0.66, planeY: 0.0,
  hp: 100, armor: 50,
