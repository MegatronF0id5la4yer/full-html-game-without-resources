const textures = [];
function createTexture(generator) {
  let tex = new Uint32Array(TEX_SIZE * TEX_SIZE);
  for (let y = 0; y < TEX_SIZE; y++) {
    for (let x = 0; x < TEX_SIZE; x++) {
      tex[y * TEX_SIZE + x] = generator(x, y);
    }
  }
  return tex;
}

// Textura 0: STARTAN3
textures.push(createTexture((x, y) => {
  let seam = (x === 0 || x === 63 || y === 0 || y === 63 || x === 31 || y === 31);
  if (seam) return abgr(42, 34, 25);
  let rivet = (x % 32 === 4 || x % 32 === 27) && (y % 32 === 4 || y % 32 === 27);
  if (rivet) return abgr(175, 170, 160);
  let edgeH = (y % 32 === 1 || x % 32 === 1);
  if (edgeH) return abgr(155, 132, 98);
  let n = ((x * 17 + y * 31) % 19);
  return abgr(132 + n, 108 + n, 76 + n);
}));

// Textura 1: Puerta
textures.push(createTexture((x, y) => {
  let frame = (x < 4 || x > 59 || y < 4 || y > 59);
  if (frame) return abgr(48, 50, 54);
  if (y >= 8 && y <= 18) {
    let stripe = Math.floor((x + y) / 6) % 2 === 0;
    return stripe ? abgr(215, 170, 20) : abgr(24, 24, 26);
  }
  let handle = (x >= 28 && x <= 35 && y >= 32 && y <= 42);
  if (handle) return abgr(180, 28, 20);
  let n = (x % 16) * 2;
  return abgr(92 + n, 95 + n, 102 + n);
}));

// Textura 2: Switch
textures.push(createTexture((x, y) => {
  if (y < 22 && x > 8 && x < 56) return (y > 6 && y < 18 && x > 12 && x < 52) ? abgr(195, 22, 16) : abgr(22, 22, 24);
  if (y > 30 && y < 50 && x > 24 && x < 40) return (y > 38) ? abgr(215, 28, 18) : abgr(32, 32, 34);
  let n = (x * 7 + y * 13) % 13;
  return abgr(85 + n, 88 + n, 92 + n);
}));

