  // Torso / Chaleco antibalas verde oliva (#4c613c)
  ctx.fillStyle = '#4c613c';
  ctx.fillRect(x - w * 0.35, topY + totalH * 0.24, w * 0.7, totalH * 0.38);

  // Piel palida de zombi (#cfa27c)
  ctx.fillStyle = '#cfa27c';
  ctx.fillRect(x - w * 0.22, topY + totalH * 0.05, w * 0.44, totalH * 0.2);

  // Casco militar verde
  ctx.fillStyle = '#3c4d30';
  ctx.fillRect(x - w * 0.26, topY, w * 0.52, totalH * 0.1);

