function abgr(r, g, b) {
  return (255 << 24) | (b << 16) | (g << 8) | r;
}

const PAL = {
  '.': 0, // Transparente
  'k': abgr(0, 0, 0),
  'w': abgr(255, 255, 255),
  'g': abgr(50, 80, 40),
  'G': abgr(80, 230, 40),
  'b': abgr(74, 43, 24),
  'B': abgr(160, 100, 60),
  's': abgr(230, 175, 135),
  'r': abgr(170, 20, 20),
  'R': abgr(255, 30, 30),
  'y': abgr(250, 220, 40),
  'd': abgr(60, 60, 60),
  'L': abgr(160, 160, 160),
  'o': abgr(120, 130, 90) // Oliva militar
};

function parseSprite(artArray) {
  const h = artArray.length;
  const w = artArray[0].length;
  const tex = new Uint32Array(w * h);
  for (let y = 0; y < h; y++) {
    for (let x = 0; x < w; x++) {
      let char = artArray[y][x];
      tex[y * w + x] = PAL[char] || 0;
    }
  }
  return { w, h, tex };
}

