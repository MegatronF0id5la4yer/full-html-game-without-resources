}

const E1M1_NOTES = [
  82.4, 82.4, 164.8, 82.4, 82.4, 146.8, 82.4, 82.4,
  130.8, 82.4, 82.4, 116.5, 82.4, 82.4, 123.5, 130.8,
  82.4, 82.4, 164.8, 82.4, 82.4, 146.8, 82.4, 82.4,
  130.8, 82.4, 82.4, 155.6, 146.8, 130.8, 116.5, 98.0
];

function updateMusic() {
  if (!audioCtx || !musicEnabled) return;
  let tempo = 0.115;
  while (nextNoteTime < audioCtx.currentTime + 0.2) {
    let note = E1M1_NOTES[noteIndex % E1M1_NOTES.length];
    playTone(note, tempo * 0.85, 'sawtooth', 0.045);
    playTone(note * 0.5, tempo * 0.85, 'triangle', 0.055);
    if (noteIndex % 4 === 0) playTone(55, 0.06, 'sine', 0.1, -25);
    if (noteIndex % 8 === 4) playNoise(0.04, 0.045);
    nextNoteTime += tempo;
    noteIndex++;
  }
}

// ==========================================
// PALETA DE COLORES ORIGINAL DE DOOM (PLAYPAL)
// ==========================================
// Generador de texturas reproduciendo los pixeles de STARTAN3, COMP2, BROWN1, BIGDOOR2 y NUKAGE
const textures = [];

function createTexture(generator) {
  let tex = new Uint32Array(TEX_SIZE * TEX_SIZE);
  for (let y = 0; y < TEX_SIZE; y++) {
    for (let x = 0; x < TEX_SIZE; x++) {
      let [r, g, b] = generator(x, y);
      tex[y * TEX_SIZE + x] = (255 << 24) | (b << 16) | (g << 8) | r;
    }
  }
  return tex;
}

// 0: STARTAN3 (Placas de metal marron-arena clasicas con juntas grises y remaches de acero)
textures.push(createTexture((x, y) => {
  let seam = (x === 0 || x === 63 || y === 0 || y === 63 || x === 31 || y === 31);
  if (seam) return [42, 34, 25]; // Ranura de sombra entre paneles
  let rivet = (x % 32 === 4 || x % 32 === 27) && (y % 32 === 4 || y % 32 === 27);
  if (rivet) return [175, 170, 160]; // Remache de acero id software
  let edgeH = (y % 32 === 1 || x % 32 === 1);
  if (edgeH) return [155, 132, 98]; // Bisel con luz
  let edgeS = (y % 32 === 30 || x % 32 === 30);
  if (edgeS) return [80, 62, 44]; // Bisel con sombra
  let n = ((x * 17 + y * 31) % 19);
  return [132 + n, 108 + n, 76 + n]; // Tono ocre STARTAN3 original
}));

// 1: COMP2 (Pared de supercomputadora UAC con pantallas de fosforo verde y terminales oscuras)
textures.push(createTexture((x, y) => {
  let frame = (x < 3 || x > 60 || y < 3 || y > 60 || y === 31 || y === 32);
  if (frame) return [38, 40, 45]; // Metal gris de soporte
  if (y > 4 && y < 28 && x > 4 && x < 59) {
    // Monitor de fosforo verde CRT
    if (y % 3 === 0) return [16, 75, 28]; // Scanlines oscuras
    let scan = (x * 7 + y * 13) % 17;
    return [24, 155 + scan * 4, 45]; // Fosforo verde UAC
  }
  // Banco de switchs y diodos LED
  let led = (x % 6 < 3) && (y > 36 && y < 58 && y % 6 < 3);
  if (led) {
    if ((x + y) % 5 === 0) return [215, 30, 20]; // Diodo rojo
    if ((x + y) % 3 === 0) return [45, 125, 215]; // Diodo azul
    return [225, 185, 30]; // Diodo ambar
  }
  let panelNoise = (x * 9 + y * 11) % 11;
  return [65 + panelNoise, 68 + panelNoise, 74 + panelNoise];
}));

// 2: BROWN1 (Pared de ladrillo tecnologico color tierra cocida)
textures.push(createTexture((x, y) => {
  let row = Math.floor(y / 16);
  let shift = (row % 2 === 1) ? 16 : 0;
  let mort = (y % 16 === 0) || ((x + shift) % 32 === 0);
  if (mort) return [32, 22, 14]; // Cemento oscuro
  let highlight = (y % 16 === 1);
  if (highlight) return [145, 96, 62];
  let n = ((x * 19 + y * 23) % 17);
  return [118 + n, 76 + n, 46 + n]; // Marron arcilla original
}));

// 3: BIGDOOR2 (Puerta de hangar de titanio con bandas de precaucion amarillas y negras)
textures.push(createTexture((x, y) => {
  let frame = (x < 4 || x > 59 || y < 4 || y > 59);
  if (frame) return [48, 50, 54]; // Marco metalico gris
  if (y >= 8 && y <= 18) {
    // Franja diagonal de advertencia clasica
    let stripe = Math.floor((x + y) / 6) % 2 === 0;
    return stripe ? [215, 170, 20] : [24, 24, 26];
  }
  let handle = (x >= 28 && x <= 35 && y >= 32 && y <= 42);
  if (handle) return [180, 28, 20]; // Manivela de apertura de emergencia roja
  let ribs = (y % 8 === 0);
  if (ribs) return [42, 44, 48];
  let n = (x % 16) * 2;
  return [92 + n, 95 + n, 102 + n]; // Chapa de acero gris id
}));

// 4: EXITSIGN / SWITCH (Letrero EXIT rojo sangre sobre consola plateada)
textures.push(createTexture((x, y) => {
  if (y < 22 && x > 8 && x < 56) {
    let isRed = (y > 6 && y < 18 && x > 12 && x < 52);
    return isRed ? [195, 22, 16] : [22, 22, 24]; // Caracteres EXIT
  }
  if (y > 30 && y < 50 && x > 24 && x < 40) {
    return (y > 38) ? [215, 28, 18] : [32, 32, 34]; // Palanca activada
  }
  let n = (x * 7 + y * 13) % 13;
  return [85 + n, 88 + n, 92 + n];
}));

// 5: TEKGREN (Paneles de aleacion verde militar de la base Phobos)
textures.push(createTexture((x, y) => {
  let seam = (x % 16 === 0 || y % 32 === 0);
  if (seam) return [24, 34, 26];
  let h = (x % 16 === 1 || y % 32 === 1);
  if (h) return [84, 115, 88];
  let n = ((x * 9 + y * 17) % 15);
  return [56 + n, 84 + n, 60 + n]; // Verde militar caracteristico
}));

// 6: SLIME WALL / NUKAGE (Pared oxidada con escurrimiento de residuo radioactivo)
textures.push(createTexture((x, y) => {
  let slime = (y > 28 + Math.sin(x * 0.35) * 12);
  if (slime) {
    let pulse = (x * 5 + y * 9) % 17;
    return [55 + pulse, 195 + pulse * 2, 35]; // Verde radioactivo autentico
  }
  let n = ((x * 11 + y * 19) % 15);
  return [105 + n, 78 + n, 52 + n]; // Metal oxidado
}));

