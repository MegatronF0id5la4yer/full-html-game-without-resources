];

let projectiles = [];
const keys = {};

window.addEventListener('keydown', e => {
  keys[e.key.toLowerCase()] = true;
  initAudio();
  if (e.key === '1') player.currentWeapon = 1;
  if (e.key === '2') player.currentWeapon = 2;
  if (e.key.toLowerCase() === 'e') interact();
  if (e.key.toLowerCase() === 'm') musicEnabled = !musicEnabled;
  if (e.key === ' ' || e.key.toLowerCase() === 'control') shootWeapon();
});
window.addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });

window.addEventListener('mousemove', e => {
  if (document.pointerLockElement === canvas) {
    rotatePlayer(e.movementX * 0.0022);
  }
});

canvas.addEventListener('click', () => {
  if (document.pointerLockElement !== canvas) {
    canvas.requestPointerLock();
  } else {
    shootWeapon();
  }
});

overlay.addEventListener('click', () => {
  overlay.style.display = 'none';
  canvas.requestPointerLock();
  initAudio();
});

function rotatePlayer(rot) {
  let oldDirX = player.dirX;
  player.dirX = player.dirX * Math.cos(rot) - player.dirY * Math.sin(rot);
  player.dirY = oldDirX * Math.sin(rot) + player.dirY * Math.cos(rot);
  let oldPlaneX = player.planeX;
  player.planeX = player.planeX * Math.cos(rot) - player.planeY * Math.sin(rot);
  player.planeY = oldPlaneX * Math.sin(rot) + player.planeY * Math.cos(rot);
}

function interact() {
  let checkX = Math.floor(player.x + player.dirX * 1.3);
  let checkY = Math.floor(player.y + player.dirY * 1.3);
  let d = getDoor(checkX, checkY);
  if (d && d.state === 'closed') {
    d.state = 'opening';
    sfxDoor();
    return;
  }
  let tile = MAP[checkY * MAP_W + checkX];
  if (tile === 5) {
    sfxItem();
    player.won = true;
    setTimeout(() => {
      alert("¡NIVEL COMPLETADO! SALISTE VIVO DEL HANGAR ( ˃͈◡˂͈)");
      location.reload();
    }, 400);
  }
}

function shootWeapon() {
  if (player.shootAnim > 0 || player.hp <= 0 || player.won) return;
  if (player.currentWeapon === 1) {
    if (player.ammoBullets <= 0) return;
    player.ammoBullets--;
    player.shootAnim = 12;
    sfxPistol();
    hitscanFire(1, 18);
  } else if (player.currentWeapon === 2) {
    if (player.ammoShells <= 0) return;
    player.ammoShells--;
    player.shootAnim = 26;
    sfxShotgun();
    hitscanFire(7, 14);
  }
}

function hitscanFire(pellets, baseDamage) {
  for (let p = 0; p < pellets; p++) {
    let spread = (p === 0) ? 0 : (Math.random() - 0.5) * 0.12;
    let rayDirX = player.dirX + player.planeX * spread;
    let rayDirY = player.dirY + player.planeY * spread;
    let closestEnemy = null;
    let minDist = 16.0;

    for (let s of sprites) {
      if ((s.type === 'imp' || s.type === 'shotgunner' || s.type === 'barrel') && s.hp > 0) {
        let ex = s.x - player.x, ey = s.y - player.y;
        let dist = Math.hypot(ex, ey);
        let dot = (ex * rayDirX + ey * rayDirY) / dist;
        if (dot > 0.96 && dist < minDist) {
          minDist = dist;
          closestEnemy = s;
        }
      }
    }

    if (closestEnemy) {
      closestEnemy.hp -= baseDamage;
      sfxMonsterHit();
      if (closestEnemy.hp <= 0) {
        if (closestEnemy.type === 'imp') { sfxImpDie(); player.kills++; }
        else if (closestEnemy.type === 'shotgunner') { sfxImpDie(); player.kills++; player.ammoShells += 4; }
        else if (closestEnemy.type === 'barrel') explodeBarrel(closestEnemy);
      }
    }
  }
}

function explodeBarrel(barrel) {
  playNoise(0.4, 0.5);
  playTone(80, 0.4, 'sawtooth', 0.4, -40);
  for (let s of sprites) {
    if (s !== barrel && s.hp > 0) {
      let d = Math.hypot(s.x - barrel.x, s.y - barrel.y);
      if (d < 3.2) s.hp -= 90;
    }
  }
  let pDist = Math.hypot(player.x - barrel.x, player.y - barrel.y);
  if (pDist < 3.5) hurtPlayer(Math.floor((3.5 - pDist) * 25));
}

function hurtPlayer(dmg) {
  if (player.armor > 0) {
    let armLoss = Math.min(player.armor, Math.floor(dmg * 0.6));
    player.armor -= armLoss;
    dmg -= armLoss;
  }
  player.hp = Math.max(0, player.hp - dmg);
  sfxPlayerOuch();
  damageFlash.style.opacity = '0.7';
  setTimeout(() => damageFlash.style.opacity = '0', 90);
  if (player.hp <= 0) {
    setTimeout(() => {
      alert("HAS CAIDO EN EL HANGAR. REINTENTANDO... (¬_¬)");
      location.reload();
    }, 500);
  }
}

function update() {
  updateMusic();
  if (player.shootAnim > 0) player.shootAnim--;

  let moveSpeed = 0.065;
  let rotSpeed = 0.04;
  if (keys['arrowleft']) rotatePlayer(-rotSpeed);
  if (keys['arrowright']) rotatePlayer(rotSpeed);

  let moveX = 0, moveY = 0;
  if (keys['w']) { moveX += player.dirX * moveSpeed; moveY += player.dirY * moveSpeed; }
  if (keys['s']) { moveX -= player.dirX * moveSpeed; moveY -= player.dirY * moveSpeed; }
  if (keys['a']) { moveX -= player.planeX * moveSpeed; moveY -= player.planeY * moveSpeed; }
  if (keys['d']) { moveX += player.planeX * moveSpeed; moveY += player.planeY * moveSpeed; }

  let checkRadius = 0.25;
  let newX = player.x + moveX;
  let newY = player.y + moveY;

  function canWalk(x, y) {
    let mx = Math.floor(x), my = Math.floor(y);
    if (mx < 0 || mx >= MAP_W || my < 0 || my >= MAP_H) return false;
    let tile = MAP[my * MAP_W + mx];
    if (tile === 4) {
      let d = getDoor(mx, my);
      return d && d.open > 0.7;
    }
    return tile === 0;
  }

  if (canWalk(newX + Math.sign(moveX) * checkRadius, player.y)) player.x = newX;
  if (canWalk(player.x, newY + Math.sign(moveY) * checkRadius)) player.y = newY;

  if (isSlimeFloor(player.x, player.y) && Math.random() < 0.08) hurtPlayer(2);

  for (let d of doors) {
    if (d.state === 'opening') {
      d.open += 0.04;
      if (d.open >= d.maxOpen) { d.open = d.maxOpen; d.state = 'stay'; d.timer = 140; }
    } else if (d.state === 'stay') {
      d.timer--;
      if (d.timer <= 0) d.state = 'closing';
    } else if (d.state === 'closing') {
      d.open -= 0.04;
      if (d.open <= 0) { d.open = 0; d.state = 'closed'; }
    }
  }

  for (let i = projectiles.length - 1; i >= 0; i--) {
    let p = projectiles[i];
    p.x += p.vx; p.y += p.vy;
    p.life--;
    if (!canWalk(p.x, p.y) || p.life <= 0) {
      projectiles.splice(i, 1);
      continue;
    }
    if (Math.hypot(p.x - player.x, p.y - player.y) < 0.45) {
      hurtPlayer(18);
      projectiles.splice(i, 1);
    }
  }

  for (let s of sprites) {
    if (s.taken) continue;
    let distToPlayer = Math.hypot(s.x - player.x, s.y - player.y);
    if (distToPlayer < 0.6) {
      if (s.type === 'medikit' && player.hp < 100) {
        player.hp = Math.min(100, player.hp + 25);
        s.taken = true; sfxItem();
        itemFlash.style.opacity = '0.5'; setTimeout(() => itemFlash.style.opacity = '0', 100);
      } else if (s.type === 'armor' && player.armor < 100) {
        player.armor = 100;
        s.taken = true; sfxItem();
        itemFlash.style.opacity = '0.5'; setTimeout(() => itemFlash.style.opacity = '0', 100);
      } else if (s.type === 'shells') {
        player.ammoShells += 8;
        s.taken = true; sfxItem();
        itemFlash.style.opacity = '0.5'; setTimeout(() => itemFlash.style.opacity = '0', 100);
      }
    }

    if ((s.type === 'imp' || s.type === 'shotgunner') && s.hp > 0) {
      s.timer = (s.timer || 0) + 1;
      let dx = player.x - s.x, dy = player.y - s.y;
      let dist = Math.hypot(dx, dy);

      if (dist < 11.0) {
        if (s.state === 'idle') { s.state = 'chase'; sfxMonsterSight(); }
        if (dist > 2.5) {
          let stepX = (dx / dist) * s.speed;
          let stepY = (dy / dist) * s.speed;
          if (canWalk(s.x + stepX, s.y)) s.x += stepX;
          if (canWalk(s.x, s.y + stepY)) s.y += stepY;
        }

        if (s.timer % 80 === 0) {
          if (s.type === 'imp') {
            projectiles.push({ x: s.x, y: s.y, vx: (dx / dist) * 0.12, vy: (dy / dist) * 0.12, life: 140 });
            playTone(320, 0.15, 'sawtooth', 0.2, -180);
          } else if (s.type === 'shotgunner' && dist < 8.0) {
            sfxPistol();
            if (Math.random() < 0.6) hurtPlayer(12);
          }
        }
      }
    }
  }
}

// ==========================================
// RENDERIZADO EN 1920x1080 (PROYECCION EXACTA)
// ==========================================
function render() {
  let halfH = VIEW_H / 2;

  // Techo y piso originales: FLOOR4_8 y CEIL5_1 con atenuacion por distancia
  for (let y = 0; y < VIEW_H; y++) {
    let isFloor = y >= halfH;
    let rowDist = isFloor ? (VIEW_H / (2.0 * y - VIEW_H)) : (VIEW_H / (VIEW_H - 2.0 * y));
    let shade = Math.min(1.0, Math.max(0.08, 1.4 / (rowDist * 0.38 + 0.7)));

    // Piso marron tierra quemada (DOOM FLAT14)
    let rF = Math.floor(58 * shade), gF = Math.floor(46 * shade), bF = Math.floor(34 * shade);
    // Techo gris plomo oscuro de hangar militar
    let rC = Math.floor(32 * shade), gC = Math.floor(34 * shade), bC = Math.floor(38 * shade);

    let color32 = isFloor ? ((255 << 24) | (bF << 16) | (gF << 8) | rF)
                          : ((255 << 24) | (bC << 16) | (gC << 8) | rC);

    let rowOffset = y * SCREEN_W;
    for (let x = 0; x < SCREEN_W; x++) {
      buf32[rowOffset + x] = color32;
    }
  }

  // Trazado de las 1920 lineas verticales en paralelo
  for (let x = 0; x < SCREEN_W; x++) {
    let cameraX = 2 * x / SCREEN_W - 1;
    let rayDirX = player.dirX + player.planeX * cameraX;
    let rayDirY = player.dirY + player.planeY * cameraX;

    let mapX = Math.floor(player.x);
    let mapY = Math.floor(player.y);

    let deltaDistX = Math.abs(1 / rayDirX);
    let deltaDistY = Math.abs(1 / rayDirY);
    let perpWallDist = 0;

    let stepX = (rayDirX < 0) ? -1 : 1;
    let stepY = (rayDirY < 0) ? -1 : 1;

    let sideDistX = (rayDirX < 0) ? (player.x - mapX) * deltaDistX : (mapX + 1.0 - player.x) * deltaDistX;
    let sideDistY = (rayDirY < 0) ? (player.y - mapY) * deltaDistY : (mapY + 1.0 - player.y) * deltaDistY;

    let hit = 0, side = 0, isDoor = false, doorOffset = 0;

    while (hit === 0) {
      if (sideDistX < sideDistY) {
        sideDistX += deltaDistX;
        mapX += stepX;
        side = 0;
      } else {
        sideDistY += deltaDistY;
        mapY += stepY;
        side = 1;
      }

      let tile = MAP[mapY * MAP_W + mapX];
      if (tile > 0) {
        if (tile === 4) {
          let d = getDoor(mapX, mapY);
          let dist = (side === 0) ? (mapX - player.x + (1 - stepX) / 2) / rayDirX : (mapY - player.y + (1 - stepY) / 2) / rayDirY;
          let hitPos = (side === 0) ? player.y + dist * rayDirY : player.x + dist * rayDirX;
          hitPos -= Math.floor(hitPos);

          if (d && hitPos < (1.0 - d.open)) {
            doorOffset = d.open;
            hit = 1; isDoor = true;
          }
        } else {
          hit = 1;
        }
      }
    }

    if (side === 0) perpWallDist = (mapX - player.x + (1 - stepX) / 2) / rayDirX;
    else            perpWallDist = (mapY - player.y + (1 - stepY) / 2) / rayDirY;

    zBuffer[x] = perpWallDist;

    let lineHeight = Math.floor(VIEW_H / perpWallDist);
    let drawStart = Math.floor(-lineHeight / 2 + VIEW_H / 2);
    let drawEnd = Math.floor(lineHeight / 2 + VIEW_H / 2);

    let clampStart = Math.max(0, drawStart);
    let clampEnd = Math.min(VIEW_H - 1, drawEnd);

    let tile = MAP[mapY * MAP_W + mapX];
    let texIdx = isDoor ? 3 : (tile - 1);
    if (texIdx < 0 || texIdx >= textures.length) texIdx = 0;
    let texture = textures[texIdx];

    let wallX = (side === 0) ? player.y + perpWallDist * rayDirY : player.x + perpWallDist * rayDirX;
    wallX -= Math.floor(wallX);
    if (isDoor) wallX += doorOffset;

    let texX = Math.floor(wallX * TEX_SIZE);
    if (side === 0 && rayDirX > 0) texX = TEX_SIZE - texX - 1;
    if (side === 1 && rayDirY < 0) texX = TEX_SIZE - texX - 1;

    // Atenuacion de luz segun distancia de la camara
    let light = Math.min(1.0, Math.max(0.12, 1.9 / (perpWallDist * 0.42 + 0.85)));
    if (side === 1) light *= 0.72; // Luz sectorial direccional

    let step = TEX_SIZE / lineHeight;
    let texPos = (clampStart - drawStart) * step;

    for (let y = clampStart; y <= clampEnd; y++) {
      let texY = Math.floor(texPos) & (TEX_SIZE - 1);
      texPos += step;
      let pixel = texture[texY * TEX_SIZE + texX];

      let r = (pixel & 0xFF) * light;
      let g = ((pixel >> 8) & 0xFF) * light;
      let b = ((pixel >> 16) & 0xFF) * light;

      buf32[y * SCREEN_W + x] = (255 << 24) | ((b & 0xFF) << 16) | ((g & 0xFF) << 8) | (r & 0xFF);
    }
  }

  // Fondo de barra de estado
  for (let y = VIEW_H; y < SCREEN_H; y++) {
    let rowOffset = y * SCREEN_W;
    for (let x = 0; x < SCREEN_W; x++) {
      buf32[rowOffset + x] = (255 << 24) | (0x2b << 16) | (0x2b << 8) | 0x2b;
    }
  }

  ctx.putImageData(imgData, 0, 0);

  renderSprites();
  renderWeapon();
  renderDoomHUD();
}

function renderSprites() {
  let allDrawables = [];
  for (let s of sprites) {
    if (!s.taken) {
      allDrawables.push({
        x: s.x, y: s.y,
        type: s.type, hp: s.hp,
        dist: Math.hypot(player.x - s.x, player.y - s.y)
      });
    }
  }
  for (let p of projectiles) {
    allDrawables.push({
      x: p.x, y: p.y,
      type: 'fireball',
      dist: Math.hypot(player.x - p.x, player.y - p.y)
    });
  }

  allDrawables.sort((a, b) => b.dist - a.dist);

  for (let spr of allDrawables) {
    let spriteX = spr.x - player.x;
    let spriteY = spr.y - player.y;

    let invDet = 1.0 / (player.planeX * player.dirY - player.dirX * player.planeY);
    let transformX = invDet * (player.dirY * spriteX - player.dirX * spriteY);
    let transformY = invDet * (-player.planeY * spriteX + player.planeX * spriteY);

    if (transformY <= 0.15) continue;

    let spriteScreenX = Math.floor((SCREEN_W / 2) * (1 + transformX / transformY));
    let spriteH = Math.abs(Math.floor(VIEW_H / transformY));
    let spriteW = spriteH;

    let drawStartY = Math.max(0, Math.floor(-spriteH / 2 + VIEW_H / 2));
    let drawEndY = Math.min(VIEW_H - 1, Math.floor(spriteH / 2 + VIEW_H / 2));
    let drawStartX = Math.max(0, Math.floor(-spriteW / 2 + spriteScreenX));
    let drawEndX = Math.min(SCREEN_W - 1, Math.floor(spriteW / 2 + spriteScreenX));

    if (spriteScreenX + spriteW / 2 < 0 || spriteScreenX - spriteW / 2 >= SCREEN_W) continue;

    ctx.save();
    for (let stripe = drawStartX; stripe < drawEndX; stripe++) {
      if (transformY < zBuffer[stripe]) {
        let size = drawEndY - drawStartY;
        let cx = spriteScreenX;
        let cy = VIEW_H / 2;

        if (spr.type === 'imp') drawImp(cx, cy, size, spr.hp <= 0);
        else if (spr.type === 'shotgunner') drawTrooper(cx, cy, size, spr.hp <= 0);
        else if (spr.type === 'barrel') drawBarrel(cx, cy, size, spr.hp <= 0);
        else if (spr.type === 'medikit') drawMedikit(cx, cy, size);
        else if (spr.type === 'armor') drawArmor(cx, cy, size);
        else if (spr.type === 'shells') drawShells(cx, cy, size);
        else if (spr.type === 'fireball') drawFireball(cx, cy, size);
        break;
      }
    }
    ctx.restore();
  }
}

