function interact() {
  let checkX = Math.floor(player.x + player.dirX * 1.3);
  let checkY = Math.floor(player.y + player.dirY * 1.3);
  let d = getDoor(checkX, checkY);
  if (d && d.state === 'closed') {
    d.state = 'opening';
    sfxDoor();
    return;
  }
  let tile = MAP[checkY * MAP_W + checkX];
  if (tile === 3) { // Exit Switch
    sfxItem();
    player.won = true;
    setTimeout(() => {
      alert("¡NIVEL PURGADO! Y YA WEY ( ˃͈◡˂͈)");
      location.reload();
    }, 500);
  }
}

function shootWeapon() {
  if (player.shootAnim > 0 || player.hp <= 0 || player.won) return;
  if (player.currentWeapon === 1) {
    if (player.ammoBullets <= 0) return;
    player.ammoBullets--; player.shootAnim = 12; sfxPistol(); hitscanFire(1, 18);
  } else if (player.currentWeapon === 2) {
    if (player.ammoShells <= 0) return;
    player.ammoShells--; player.shootAnim = 26; sfxShotgun(); hitscanFire(7, 14);
  }
}

function hitscanFire(pellets, baseDamage) {
  for (let p = 0; p < pellets; p++) {
    let spread = (p === 0) ? 0 : (Math.random() - 0.5) * 0.12;
    let rayDirX = player.dirX + player.planeX * spread;
    let rayDirY = player.dirY + player.planeY * spread;
    let closestEnemy = null;
    let minDist = 16.0;

    for (let s of sprites) {
      if ((s.type === 'imp' || s.type === 'shotgunner' || s.type === 'barrel') && s.hp > 0) {
        let ex = s.x - player.x, ey = s.y - player.y;
        let dist = Math.hypot(ex, ey);
        let dot = (ex * rayDirX + ey * rayDirY) / dist;
        if (dot > 0.96 && dist < minDist) { minDist = dist; closestEnemy = s; }
      }
    }
    if (closestEnemy) {
      closestEnemy.hp -= baseDamage;
      sfxMonsterHit();
      if (closestEnemy.hp <= 0) {
        if (closestEnemy.type === 'barrel') {
          playNoise(0.4, 0.5); playTone(80, 0.4, 'sawtooth', 0.4, -40);
          let pDist = Math.hypot(player.x - closestEnemy.x, player.y - closestEnemy.y);
          if (pDist < 3.5) hurtPlayer(Math.floor((3.5 - pDist) * 25));
        } else {
          sfxImpDie(); player.kills++;
          if (closestEnemy.type === 'shotgunner') player.ammoShells += 4;
        }
      }
    }
  }
}

function hurtPlayer(dmg) {
  if (player.armor > 0) { let armLoss = Math.min(player.armor, Math.floor(dmg * 0.6)); player.armor -= armLoss; dmg -= armLoss; }
  player.hp = Math.max(0, player.hp - dmg);
  sfxPlayerOuch();
  damageFlash.style.opacity = '0.7';
  setTimeout(() => damageFlash.style.opacity = '0', 90);
  if (player.hp <= 0) {
    setTimeout(() => { alert("TE CARGO LA VERGA SOKETE. REINTENTANDO... (¬_¬)"); location.reload(); }, 500);
  }
}

function updateGame() {
  updateMusic();
  if (player.shootAnim > 0) player.shootAnim--;

  let moveSpeed = 0.065;
  let rotSpeed = 0.04;
  if (keys['arrowleft']) { let rot = -rotSpeed; let oldDirX = player.dirX; player.dirX = player.dirX * Math.cos(rot) - player.dirY * Math.sin(rot); player.dirY = oldDirX * Math.sin(rot) + player.dirY * Math.cos(rot); let oldPlaneX = player.planeX; player.planeX = player.planeX * Math.cos(rot) - player.planeY * Math.sin(rot); player.planeY = oldPlaneX * Math.sin(rot) + player.planeY * Math.cos(rot); }
  if (keys['arrowright']) { let rot = rotSpeed; let oldDirX = player.dirX; player.dirX = player.dirX * Math.cos(rot) - player.dirY * Math.sin(rot); player.dirY = oldDirX * Math.sin(rot) + player.dirY * Math.cos(rot); let oldPlaneX = player.planeX; player.planeX = player.planeX * Math.cos(rot) - player.planeY * Math.sin(rot); player.planeY = oldPlaneX * Math.sin(rot) + player.planeY * Math.cos(rot); }

  let moveX = 0, moveY = 0;
  if (keys['w']) { moveX += player.dirX * moveSpeed; moveY += player.dirY * moveSpeed; }
  if (keys['s']) { moveX -= player.dirX * moveSpeed; moveY -= player.dirY * moveSpeed; }
  if (keys['a']) { moveX -= player.planeX * moveSpeed; moveY -= player.planeY * moveSpeed; }
  if (keys['d']) { moveX += player.planeX * moveSpeed; moveY += player.planeY * moveSpeed; }

  let checkRadius = 0.25;
  let newX = player.x + moveX;
  let newY = player.y + moveY;

  function canWalk(x, y) {
    let mx = Math.floor(x), my = Math.floor(y);
    if (mx < 0 || mx >= MAP_W || my < 0 || my >= MAP_H) return false;
    let tile = MAP[my * MAP_W + mx];
    if (tile === 2) { let d = getDoor(mx, my); return d && d.open > 0.7; }
    return tile === 0;
  }

  if (canWalk(newX + Math.sign(moveX) * checkRadius, player.y)) player.x = newX;
  if (canWalk(player.x, newY + Math.sign(moveY) * checkRadius)) player.y = newY;

  for (let d of doors) {
    if (d.state === 'opening') { d.open += 0.04; if (d.open >= d.maxOpen) { d.open = d.maxOpen; d.state = 'stay'; d.timer = 140; } }
    else if (d.state === 'stay') { d.timer--; if (d.timer <= 0) d.state = 'closing'; }
    else if (d.state === 'closing') { d.open -= 0.04; if (d.open <= 0) { d.open = 0; d.state = 'closed'; } }
  }

  for (let s of sprites) {
    if (s.taken) continue;
    let distToPlayer = Math.hypot(s.x - player.x, s.y - player.y);
    if (distToPlayer < 0.6 && s.type === 'medikit' && player.hp < 100) {
      player.hp = Math.min(100, player.hp + 25);
      s.taken = true; sfxItem();
    }

    if ((s.type === 'imp' || s.type === 'shotgunner') && s.hp > 0) {
      s.timer++;
      if (distToPlayer < 11.0) {
        if (distToPlayer > 2.5) {
          let stepX = ((player.x - s.x) / distToPlayer) * s.speed;
          let stepY = ((player.y - s.y) / distToPlayer) * s.speed;
          if (canWalk(s.x + stepX, s.y)) s.x += stepX;
          if (canWalk(s.x, s.y + stepY)) s.y += stepY;
        }
        if (s.timer % 80 === 0 && s.type === 'shotgunner' && distToPlayer < 8.0) {
          sfxPistol(); if (Math.random() < 0.6) hurtPlayer(12);
        }
      }
    }
  }
}

function renderGame() {
  let halfH = VIEW_H / 2;

  // Render Floor and Ceiling
  for (let y = 0; y < VIEW_H; y++) {
    let isFloor = y >= halfH;
    let rowDist = isFloor ? (VIEW_H / (2.0 * y - VIEW_H)) : (VIEW_H / (VIEW_H - 2.0 * y));
    let shade = Math.min(1.0, Math.max(0.08, 1.4 / (rowDist * 0.38 + 0.7)));

    let rF = Math.floor(58 * shade), gF = Math.floor(46 * shade), bF = Math.floor(34 * shade);
    let rC = Math.floor(32 * shade), gC = Math.floor(34 * shade), bC = Math.floor(38 * shade);
    let color32 = isFloor ? abgr(rF, gF, bF) : abgr(rC, gC, bC);

    let rowOffset = y * SCREEN_W;
    for (let x = 0; x < SCREEN_W; x++) buf32[rowOffset + x] = color32;
  }

  // Render Walls
  for (let x = 0; x < SCREEN_W; x++) {
    let cameraX = 2 * x / SCREEN_W - 1;
    let rayDirX = player.dirX + player.planeX * cameraX;
    let rayDirY = player.dirY + player.planeY * cameraX;

    let mapX = Math.floor(player.x);
    let mapY = Math.floor(player.y);
    let deltaDistX = Math.abs(1 / rayDirX);
    let deltaDistY = Math.abs(1 / rayDirY);
    let perpWallDist = 0;
    let stepX = (rayDirX < 0) ? -1 : 1;
    let stepY = (rayDirY < 0) ? -1 : 1;
    let sideDistX = (rayDirX < 0) ? (player.x - mapX) * deltaDistX : (mapX + 1.0 - player.x) * deltaDistX;
    let sideDistY = (rayDirY < 0) ? (player.y - mapY) * deltaDistY : (mapY + 1.0 - player.y) * deltaDistY;

    let hit = 0, side = 0, isDoor = false, doorOffset = 0;

    while (hit === 0) {
      if (sideDistX < sideDistY) { sideDistX += deltaDistX; mapX += stepX; side = 0; }
      else { sideDistY += deltaDistY; mapY += stepY; side = 1; }
      let tile = MAP[mapY * MAP_W + mapX];
      if (tile > 0) {
        if (tile === 2) {
          let d = getDoor(mapX, mapY);
          let dist = (side === 0) ? (mapX - player.x + (1 - stepX) / 2) / rayDirX : (mapY - player.y + (1 - stepY) / 2) / rayDirY;
          let hitPos = (side === 0) ? player.y + dist * rayDirY : player.x + dist * rayDirX;
          hitPos -= Math.floor(hitPos);
          if (d && hitPos < (1.0 - d.open)) { doorOffset = d.open; hit = 1; isDoor = true; }
        } else { hit = 1; }
      }
    }

    if (side === 0) perpWallDist = (mapX - player.x + (1 - stepX) / 2) / rayDirX;
    else            perpWallDist = (mapY - player.y + (1 - stepY) / 2) / rayDirY;
    zBuffer[x] = perpWallDist;

    let lineHeight = Math.floor(VIEW_H / perpWallDist);
    let drawStart = Math.floor(-lineHeight / 2 + VIEW_H / 2);
    let drawEnd = Math.floor(lineHeight / 2 + VIEW_H / 2);
    let clampStart = Math.max(0, drawStart);
    let clampEnd = Math.min(VIEW_H - 1, drawEnd);

    let tile = MAP[mapY * MAP_W + mapX];
    let texIdx = isDoor ? 1 : (tile === 3 ? 2 : 0);
    let texture = textures[texIdx];

    let wallX = (side === 0) ? player.y + perpWallDist * rayDirY : player.x + perpWallDist * rayDirX;
    wallX -= Math.floor(wallX);
    if (isDoor) wallX += doorOffset;
    let texX = Math.floor(wallX * TEX_SIZE);
    if (side === 0 && rayDirX > 0) texX = TEX_SIZE - texX - 1;
    if (side === 1 && rayDirY < 0) texX = TEX_SIZE - texX - 1;

    let light = Math.min(1.0, Math.max(0.12, 1.9 / (perpWallDist * 0.42 + 0.85)));
    if (side === 1) light *= 0.72;

    let step = TEX_SIZE / lineHeight;
    let texPos = (clampStart - drawStart) * step;

    for (let y = clampStart; y <= clampEnd; y++) {
      let texY = Math.floor(texPos) & (TEX_SIZE - 1);
      texPos += step;
      let pixel = texture[texY * TEX_SIZE + texX];
      let r = (pixel & 0xFF) * light;
      let g = ((pixel >> 8) & 0xFF) * light;
      let b = ((pixel >> 16) & 0xFF) * light;
      buf32[y * SCREEN_W + x] = abgr(r, g, b);
    }
  }

  // Draw HUD background
  for (let y = VIEW_H; y < SCREEN_H; y++) {
    let rowOffset = y * SCREEN_W;
    for (let x = 0; x < SCREEN_W; x++) buf32[rowOffset + x] = abgr(43, 43, 43);
  }

  // Render Sprites via Raycaster Proyector (using exact pixel art)
  let allSprites = sprites.filter(s => !s.taken).map(s => ({
    x: s.x, y: s.y, type: s.type, hp: s.hp,
    dist: Math.hypot(player.x - s.x, player.y - s.y)
  })).sort((a, b) => b.dist - a.dist);

  for (let spr of allSprites) {
    let spriteX = spr.x - player.x;
    let spriteY = spr.y - player.y;
    let invDet = 1.0 / (player.planeX * player.dirY - player.dirX * player.planeY);
    let transformX = invDet * (player.dirY * spriteX - player.dirX * spriteY);
    let transformY = invDet * (-player.planeY * spriteX + player.planeX * spriteY);

    if (transformY <= 0.15) continue;

    let spriteScreenX = Math.floor((SCREEN_W / 2) * (1 + transformX / transformY));
    let spriteH = Math.abs(Math.floor(VIEW_H / transformY));
    let spriteW = Math.abs(Math.floor(VIEW_H / transformY)) * 0.7; // Aspect ratio calc

    let drawStartY = Math.floor(-spriteH / 2 + VIEW_H / 2);
    let drawEndY = Math.floor(spriteH / 2 + VIEW_H / 2);
    let drawStartX = Math.floor(-spriteW / 2 + spriteScreenX);
    let drawEndX = Math.floor(spriteW / 2 + spriteScreenX);

    let clampStartY = Math.max(0, drawStartY);
    let clampEndY = Math.min(VIEW_H - 1, drawEndY);
    let clampStartX = Math.max(0, drawStartX);
    let clampEndX = Math.min(SCREEN_W - 1, drawEndX);

    let artObj = null;
    if (spr.type === 'imp') artObj = SPR_IMP;
    else if (spr.type === 'shotgunner') artObj = SPR_TROOPER;
    else if (spr.type === 'barrel') artObj = SPR_BARREL;
    else if (spr.type === 'medikit') artObj = SPR_MEDIKIT;

    if (artObj && (!spr.hp || spr.hp > 0 || spr.type === 'barrel')) { // Solo renderizar vivos por ahora o barriles intactos
      let stepX = artObj.w / spriteW;
      let stepY = artObj.h / spriteH;

      for (let stripe = clampStartX; stripe < clampEndX; stripe++) {
        if (transformY < zBuffer[stripe]) {
          let texX = Math.floor((stripe - drawStartX) * stepX);
          for (let y = clampStartY; y < clampEndY; y++) {
            let texY = Math.floor((y - drawStartY) * stepY);
            let color = artObj.tex[texY * artObj.w + texX];
            if (color !== 0) { // Transparencia
              buf32[y * SCREEN_W + stripe] = color;
            }
          }
        }
      }
    }
  }

  ctx.putImageData(imgData, 0, 0);

  // Render HUD Overlay
  renderWeapon();
  renderDoomHUD();
}

function renderWeapon() {
  let cx = SCREEN_W / 2;
  let cy = VIEW_H;
  let bob = Math.sin(performance.now() * 0.008) * 8;

  if (player.currentWeapon === 1) {
    let f = player.shootAnim;
    let kick = (f > 8) ? (f - 8) * 9 : 0;
    ctx.fillStyle = '#cfa27c';
    ctx.fillRect(cx - 30, cy - 130 + bob + kick, 60, 140);
    ctx.fillStyle = '#33353b';
    ctx.fillRect(cx - 18, cy - 240 + bob + kick, 36, 120);
    ctx.fillStyle = '#585b63';
    ctx.fillRect(cx - 10, cy - 250 + bob + kick, 20, 20);
    if (f > 8) {
      ctx.fillStyle = '#ffe852';
      ctx.beginPath(); ctx.arc(cx, cy - 265 + kick, 45, 0, Math.PI * 2); ctx.fill();
    }
  } else if (player.currentWeapon === 2) {
    let f = player.shootAnim;
    let kick = (f > 22) ? (f - 22) * 12 : 0;
    let pump = (f > 8 && f <= 18) ? Math.sin((f - 8) * 0.31) * 35 : 0;
    ctx.fillStyle = '#cfa27c';
    ctx.fillRect(cx - 140, cy - 120 + bob, 80, 130);
    ctx.fillRect(cx + 80, cy - 140 + bob + kick, 90, 140);
    ctx.fillStyle = '#2b2d33';
    ctx.fillRect(cx - 45, cy - 310 + bob + kick, 90, 260);
    ctx.fillStyle = '#4c5059';
    ctx.fillRect(cx - 38, cy - 325 + bob + kick, 34, 30);
    ctx.fillRect(cx + 4, cy - 325 + bob + kick, 34, 30);
    ctx.fillStyle = '#6b3c1b';
    ctx.fillRect(cx - 48, cy - 180 + bob + kick + pump, 96, 65);
    ctx.fillStyle = '#9e5927';
    ctx.fillRect(cx - 42, cy - 176 + bob + kick + pump, 84, 8);
    if (f > 22) {
      let fGrad = ctx.createRadialGradient(cx, cy - 340 + kick, 10, cx, cy - 340 + kick, 120);
      fGrad.addColorStop(0, '#ffffff'); fGrad.addColorStop(0.4, '#ffd52b'); fGrad.addColorStop(1, 'rgba(215, 35, 10, 0)');
      ctx.fillStyle = fGrad; ctx.beginPath(); ctx.arc(cx, cy - 340 + kick, 130, 0, Math.PI * 2); ctx.fill();
    }
  }

  ctx.strokeStyle = 'rgba(255, 255, 255, 0.5)'; ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(cx - 8, VIEW_H / 2); ctx.lineTo(cx + 8, VIEW_H / 2);
  ctx.moveTo(cx, VIEW_H / 2 - 8); ctx.lineTo(cx, VIEW_H / 2 + 8);
  ctx.stroke();
}

function renderDoomHUD() {
  let hy = VIEW_H;
  ctx.fillStyle = '#1c1c1c'; ctx.fillRect(0, hy, SCREEN_W, 6);
  ctx.font = 'bold 36px monospace'; ctx.textBaseline = 'middle';

  // AMMO
  ctx.fillStyle = '#1c1c1c'; ctx.fillRect(58, hy + 23, 264, 124);
  ctx.fillStyle = '#6e150a'; ctx.fillRect(60, hy + 25, 260, 120);
  ctx.fillStyle = '#bf1e15'; ctx.fillText('AMMO', 80, hy + 55);
  ctx.fillStyle = '#d49b28';
  let curAmmo = (player.currentWeapon === 2) ? player.ammoShells : player.ammoBullets;
  ctx.fillText(curAmmo.toString().padStart(3, ' '), 180, hy + 98);

  // HEALTH
  ctx.fillStyle = '#1c1c1c'; ctx.fillRect(358, hy + 23, 304, 124);
  ctx.fillStyle = '#1a291a'; ctx.fillRect(360, hy + 25, 300, 120);
  ctx.fillStyle = '#bf1e15'; ctx.fillText('HEALTH', 380, hy + 55);
  ctx.fillStyle = '#d49b28'; ctx.fillText(`${Math.max(0, player.hp)}%`, 500, hy + 98);

  // FACE
  let faceX = SCREEN_W / 2; let faceY = hy + HUD_H / 2;
  ctx.fillStyle = '#1c1c1c'; ctx.fillRect(faceX - 72, hy + 18, 144, 134);
  ctx.fillStyle = '#262626'; ctx.fillRect(faceX - 70, hy + 20, 140, 130);
  
  let hp = player.hp;
  ctx.fillStyle = (hp > 0) ? '#d99f77' : '#731a1a'; ctx.fillRect(faceX - 45, faceY - 48, 90, 96);
  ctx.fillStyle = '#4a2d18'; ctx.fillRect(faceX - 45, faceY - 48, 90, 24);
  if (hp > 0) {
    let look = Math.sin(performance.now() * 0.003) * 6;
    ctx.fillStyle = '#fff'; ctx.fillRect(faceX - 28, faceY - 16, 18, 12); ctx.fillRect(faceX + 10, faceY - 16, 18, 12);
    ctx.fillStyle = '#2244aa'; ctx.fillRect(faceX - 24 + look, faceY - 14, 10, 8); ctx.fillRect(faceX + 14 + look, faceY - 14, 10, 8);
    if (player.shootAnim > 18) { ctx.fillStyle = '#551111'; ctx.fillRect(faceX - 22, faceY + 16, 44, 14); ctx.fillStyle = '#ffffff'; ctx.fillRect(faceX - 18, faceY + 18, 36, 4); }
    else if (hp < 30) { ctx.fillStyle = '#990000'; ctx.fillRect(faceX - 25, faceY - 5, 12, 28); ctx.fillStyle = '#400'; ctx.fillRect(faceX - 18, faceY + 20, 36, 12); }
    else { ctx.fillStyle = '#6e3820'; ctx.fillRect(faceX - 18, faceY + 20, 36, 6); }
  } else {
    ctx.strokeStyle = '#fff'; ctx.lineWidth = 3; ctx.beginPath();
    ctx.moveTo(faceX - 25, faceY - 15); ctx.lineTo(faceX - 10, faceY - 5); ctx.moveTo(faceX - 10, faceY - 15); ctx.lineTo(faceX - 25, faceY - 5);
    ctx.moveTo(faceX + 10, faceY - 15); ctx.lineTo(faceX + 25, faceY - 5); ctx.moveTo(faceX + 25, faceY - 15); ctx.lineTo(faceX + 10, faceY - 5); ctx.stroke();
  }

  // ARMOR & STATS
  ctx.fillStyle = '#1c1c1c'; ctx.fillRect(SCREEN_W - 662, hy + 23, 304, 124);
  ctx.fillStyle = '#141d2e'; ctx.fillRect(SCREEN_W - 660, hy + 25, 300, 120);
  ctx.fillStyle = '#bf1e15'; ctx.fillText('ARMOR', SCREEN_W - 640, hy + 55);
  ctx.fillStyle = '#d49b28'; ctx.fillText(`${player.armor}%`, SCREEN_W - 520, hy + 98);

  ctx.fillStyle = '#1c1c1c'; ctx.fillRect(SCREEN_W - 322, hy + 23, 264, 124);
  ctx.fillStyle = '#222'; ctx.fillRect(SCREEN_W - 320, hy + 25, 260, 120);
  ctx.font = 'bold 22px monospace'; ctx.fillStyle = '#aaa';
  ctx.fillText(`FRAGS: ${player.kills}`, SCREEN_W - 300, hy + 65);
  ctx.fillStyle = '#bf1e15'; ctx.fillText(`LEVEL: E1M1`, SCREEN_W - 300, hy + 105);
}

// ==========================================
// RENDER MENU CLASICO
// ==========================================
function drawScaledSprite(artObj, sx, sy, scale) {
  for(let y=0; y<artObj.h; y++){
    for(let x=0; x<artObj.w; x++){
      let color = artObj.tex[y*artObj.w + x];
      if(color !== 0) {
        let a = (color >> 24) & 0xFF;
        let b = (color >> 16) & 0xFF;
        let g = (color >> 8) & 0xFF;
        let r = color & 0xFF;
        ctx.fillStyle = `rgba(${r},${g},${b},${a/255})`;
        ctx.fillRect(sx + x*scale, sy + y*scale, scale, scale);
      }
    }
  }
}

function renderMenu() {
  // Fondo de menu super oldschool (rojo oscuro)
  let grad = ctx.createLinearGradient(0, 0, 0, SCREEN_H);
  grad.addColorStop(0, '#550000');
  grad.addColorStop(1, '#110000');
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, SCREEN_W, SCREEN_H);

  // Logo DOOM pseudo-3D
  ctx.font = 'bold 180px monospace';
  ctx.textAlign = 'center';
  ctx.fillStyle = '#220000'; ctx.fillText('DOOM', SCREEN_W/2 + 8, 258);
  ctx.fillStyle = '#ddaa44'; ctx.fillText('DOOM', SCREEN_W/2, 250);

  // Opciones
  ctx.font = 'bold 50px monospace';
  ctx.textAlign = 'left';
  let startY = 500;
  let spacing = 70;
  
  for(let i=0; i<MENU_OPTS.length; i++){
    ctx.fillStyle = (i === menuIndex) ? '#ff2222' : '#aaaaaa';
    ctx.fillText(MENU_OPTS[i], SCREEN_W/2 - 120, startY + i*spacing);
    
    if(i === menuIndex) {
      // Dibujar calavera cursor
      drawScaledSprite(SPR_SKULL, SCREEN_W/2 - 220, startY + i*spacing - 45, 4);
    }
  }

  // Footer
  ctx.fillStyle = '#555';
  ctx.font = '25px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('v1.9 1920x1080 HTML5 NATIVE - PRESIONA ENTER PARA JUGAR', SCREEN_W/2, SCREEN_H - 40);
}

// Bucle principal general
function loop() {
  if (gameState === 'MENU') {
    renderMenu();
  } else if (gameState === 'GAME') {
    updateGame();
    renderGame();
  }
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
</script>
