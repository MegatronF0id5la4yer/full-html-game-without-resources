<script>
// ==========================================
// CONSTANTES DE RESOLUCION NATIVA (1920x1080)
// ==========================================
const SCREEN_W = 1920;
const SCREEN_H = 1080;
const HUD_H = 170;
const VIEW_H = SCREEN_H - HUD_H;
const TEX_SIZE = 64;

const canvas = document.getElementById('view');
const ctx = canvas.getContext('2d');
const overlay = document.getElementById('overlay');
